{
  "name": "ketoklar-publisher",
  "compatibility_date": "2026-08-01",
  "main": "src/index.ts",
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ketoklar-db",
      "database_id": "95d6ceb5-594e-4824-a120-fa6a54bccce9"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "ketoklar-images"
    }
  ],
  "vars": {
    "IMAGES_PUBLIC_BASE_URL": "https://pub-ab5c905b17b94eb583d9e36baf5e185f.r2.dev"
  }
}

---
import Layout from '../../layouts/Layout.astro';
import type { Article } from '../../lib/db';
import { absoluteUrl } from '../../lib/seo';

import { env } from "cloudflare:workers";
const db = env.DB;

const { results: articles } = await db
  .prepare(`SELECT * FROM articles WHERE status = 'godkendt' AND published_at IS NOT NULL AND published_at <= datetime('now') AND category IN ('videnskab','livsstil') ORDER BY published_at DESC`)
  .all<Article>();

const description = 'Læs danske artikler om keto, fedt, kulhydrater og hverdagen med ketogen kost – skrevet uden løftede pegefingre.';
const itemList = {
  '@type': 'ItemList',
  name: 'Artikler om keto',
  numberOfItems: articles.length,
  itemListElement: articles.map((article, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: absoluteUrl(`/artikler/${article.slug}`),
    name: article.title,
  })),
};
---

<Layout title="Artikler om keto, kost og livsstil" description={description} image={articles[0]?.image_url} structuredData={itemList}>
  <h1 class="text-3xl font-display font-600 mb-6">Artikler om keto</h1>
  <p class="text-[var(--ink)] mb-8">Videnskaben bag keto, og hvorfor det er den fede måde at leve på.</p>

  <div class="grid sm:grid-cols-2 gap-6">
    {articles.map((a) => (
      <a href={`/artikler/${a.slug}`} class="block bg-[var(--card)] rounded-2xl border border-[var(--ink)]/15 overflow-hidden hover:shadow-md transition relative">
        {a.locked === 1 && (
          <span class="absolute top-4 right-4 z-10 text-xs bg-[var(--ink)] text-white px-2 py-1 rounded-full">Kun abonnenter</span>
        )}
        {a.image_url && <img src={a.image_url} alt={a.title} class="aspect-[16/9] w-full object-cover" loading="lazy" />}
        <div class="p-6">
          <span class="text-xs uppercase tracking-wide text-[var(--rust)] font-semibold">{a.category}</span>
          <h2 class="text-lg font-display font-600 mt-1">{a.title}</h2>
          <p class="text-sm text-[var(--sage)] mt-2">{a.excerpt}</p>
        </div>
      </a>
    ))}
  </div>

  {articles.length === 0 && <p class="text-[var(--sage)]">Ingen artikler endnu.</p>}
</Layout>

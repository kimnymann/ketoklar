---
import Layout from '../../layouts/Layout.astro';
import type { Article, Recipe } from '../../lib/db';
import { CATEGORY_LABELS, formatPublishedDate } from '../../lib/db';
import { parseArticleBody } from '../../lib/articleBody';
import { KETO_FOOD_LIST } from '../../lib/ketoFoodList';
import AnecdoteArticle from '../../components/AnecdoteArticle.astro';
import ArticleAuthor from '../../components/ArticleAuthor.astro';
import { absoluteUrl, breadcrumbJsonLd, toIsoDateTime } from '../../lib/seo';
import { env } from "cloudflare:workers";

const { slug } = Astro.params;
const db = env.DB;

const article = await db
  .prepare(`SELECT * FROM articles WHERE slug = ? AND status = 'godkendt' AND published_at IS NOT NULL AND published_at <= datetime('now')`)
  .bind(slug)
  .first<Article>();

if (!article) {
  return Astro.redirect('/artikler');
}

const { results: relatedRecipes } = await db
  .prepare(`
    SELECT r.* FROM recipes r
    JOIN article_recipes ar ON ar.recipe_id = r.id
    WHERE ar.article_id = ? AND r.status = 'godkendt' AND r.published_at IS NOT NULL AND r.published_at <= datetime('now')
  `)
  .bind(article.id)
  .all<Recipe>();

const recipesBySlug = new Map(relatedRecipes.map((r) => [r.slug, r]));

const { results: bodyImages } = await db
  .prepare(`SELECT marker, image_url, image_status FROM article_images WHERE article_id = ?`)
  .bind(article.id)
  .all<{ marker: string; image_url: string | null; image_status: string }>();
const bodyImagesByMarker = new Map(bodyImages.map((i) => [i.marker, i]));
let articleImageCount = 0;

// TODO fase 2: erstat med rigtigt abonnements-tjek (session/cookie)
const isSubscriber = false;
const isLocked = article.locked === 1 && !isSubscriber;
const blocks = isLocked ? [] : parseArticleBody(article.body);
const contents = blocks.flatMap((block, index) => block.type === 'heading'
  ? [{ text: block.text, id: `afsnit-${index}`, index }] : []);
const contentsStart = contents[0]?.index;

const heroColors: Record<Article['category'], string> = {
  videnskab: 'var(--sage)',
  livsstil: 'var(--rust)',
  anekdote: 'var(--ink)',
};

let nextAnecdote: Article | null = null;
if (article.category === 'anekdote') {
  const { results: anecdotes } = await db
    .prepare(`SELECT * FROM articles WHERE category = 'anekdote' AND status = 'godkendt' AND published_at IS NOT NULL AND published_at <= datetime('now') ORDER BY published_at DESC, id DESC`)
    .all<Article>();
  if (anecdotes.length > 1) {
    const currentIndex = anecdotes.findIndex((item) => item.id === article.id);
    nextAnecdote = anecdotes[(currentIndex + 1) % anecdotes.length] ?? null;
  }
}

const articleDescription = article.excerpt ?? `${article.title} – læs artiklen på Ketoklar.`;
const articleUrl = absoluteUrl(`/artikler/${article.slug}`);
const articleStructuredData = {
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: article.title,
  description: articleDescription,
  ...(article.image_url ? { image: [absoluteUrl(article.image_url)] } : {}),
  ...(toIsoDateTime(article.published_at) ? { datePublished: toIsoDateTime(article.published_at) } : {}),
  ...(toIsoDateTime(article.updated_at ?? null) ? { dateModified: toIsoDateTime(article.updated_at ?? null) } : {}),
  mainEntityOfPage: articleUrl,
  inLanguage: 'da-DK',
  publisher: { '@id': 'https://ketoklar.dk/#organization' },
  author: {
    '@type': 'Person',
    '@id': 'https://ketoklar.dk/om-kim-sax#person',
    name: 'Kim Sax',
    url: 'https://ketoklar.dk/om-kim-sax',
  },
  isPartOf: { '@id': 'https://ketoklar.dk/#website' },
  articleSection: article.category === 'anekdote' ? 'Anekdoter' : article.category,
};
---

<Layout
  title={article.title}
  description={articleDescription}
  image={article.image_url}
  pageType="article"
  structuredData={[
    articleStructuredData,
    breadcrumbJsonLd([
      { name: 'Forside', path: '/' },
      { name: article.category === 'anekdote' ? 'Anekdoter' : 'Artikler', path: article.category === 'anekdote' ? '/artikler/anekdoter' : '/artikler' },
      { name: article.title, path: `/artikler/${article.slug}` },
    ]),
  ]}
>
  {article.category === 'anekdote' ? (
    <AnecdoteArticle
      article={article}
      relatedRecipes={relatedRecipes}
      bodyImages={bodyImages}
      nextAnecdote={nextAnecdote}
      isLocked={isLocked}
    />
  ) : (
    <>
  {article.image_url ? (
    <img src={article.image_url} alt={article.title} class="w-full aspect-[21/9] object-cover rounded-sm mb-8" />
  ) : (
    <div class="aspect-[21/9] mb-8 flex items-end p-8 rounded-sm" style={`background-color: ${heroColors[article.category]};`}>
      <div>
        <div class="flex items-baseline gap-3">
          <span class="text-xs uppercase tracking-wide font-semibold" style="color: var(--paper-light);">{article.category}</span>
          <time datetime={toIsoDateTime(article.published_at)} class="text-xs" style="color: var(--paper);">{formatPublishedDate(article.published_at)}</time>
        </div>
        <h1 class="font-display text-3xl md:text-4xl font-700 mt-1" style="color: var(--paper-light);">{article.title}</h1>
      </div>
    </div>
  )}
  {article.image_url && (
    <div class="max-w-3xl mx-auto mb-8">
      <div class="flex items-baseline justify-between">
        <span class="text-xs uppercase tracking-wide font-semibold" style="color: var(--rust);">{article.category}</span>
        <time datetime={toIsoDateTime(article.published_at)} class="text-xs" style="color: var(--sage);">{formatPublishedDate(article.published_at)}</time>
      </div>
      <h1 class="font-display text-3xl md:text-4xl font-700 mt-1" style="color: var(--ink);">{article.title}</h1>
    </div>
  )}

  <ArticleAuthor />
  {article.updated_at && (
    <p class="max-w-3xl mx-auto mb-6 text-sm text-[var(--sage)]">
      Senest opdateret <time datetime={toIsoDateTime(article.updated_at)}>{formatPublishedDate(article.updated_at)}</time>
    </p>
  )}

  {isLocked ? (
    <div class="bg-[var(--paper-light)] border border-[var(--ink)]/15 rounded-2xl p-10 text-center">
      <p class="text-lg font-semibold mb-2">Denne artikel er kun for abonnenter.</p>
      <p class="text-[var(--sage)] mb-6">Bliv abonnent og få adgang til alt indhold på Ketoklar.</p>
      <a href="/abonnement" class="inline-block bg-[var(--rust)] text-white px-6 py-3 rounded-full font-medium hover:bg-[var(--rust-dark)] transition">
        Se abonnement
      </a>
    </div>
  ) : (
    <div class="max-w-3xl mx-auto leading-relaxed space-y-5" style="color: var(--ink);">
      {blocks.map((block, index) => {
        if (block.type === 'heading') {
          return <>
            {index === contentsStart && contents.length >= 3 && (
              <nav aria-label="Indholdsfortegnelse" class="article-contents">
                <p class="font-semibold mb-3">I denne artikel</p>
                <ul class="space-y-2">
                  {contents.map((entry) => <li><a class="ketoklar-inline-link" href={`#${entry.id}`}>{entry.text}</a></li>)}
                </ul>
              </nav>
            )}
            <h2 id={`afsnit-${index}`} tabindex="-1" class="font-display text-xl font-600 pt-3 scroll-mt-6" style="color: var(--ink);">{block.text}</h2>
          </>;
        }
        if (block.type === 'quote') {
          return (
            <blockquote class="border-l-4 pl-5 py-1 my-2" style="border-color: var(--rust);">
              <p class="font-display text-xl italic" style="color: var(--rust-dark);">{block.text}</p>
            </blockquote>
          );
        }
        if (block.type === 'list') {
          return (
            <ul class="list-disc space-y-2 pl-6 marker:text-[var(--rust)]">
              {block.items.map((item) => <li set:html={item} />)}
            </ul>
          );
        }
        if (block.type === 'recipe') {
          const r = recipesBySlug.get(block.slug);
          if (!r) return null;
          return (
            <a href={`/opskrifter/${r.slug}`} class="not-prose flex items-center gap-4 bg-[var(--card)] border border-[var(--ink)]/15 rounded-2xl p-4 hover:shadow-md transition my-2">
              {r.image_url ? (
                <img src={r.image_url} alt={r.title} class="w-16 h-16 flex-shrink-0 rounded-lg object-cover" loading="lazy" />
              ) : (
                <div class="w-16 h-16 flex-shrink-0 rounded-lg" style="background-color: var(--sage);"></div>
              )}
              <div>
                <span class="text-xs uppercase tracking-wide font-semibold" style="color: var(--rust);">Opskrift, {CATEGORY_LABELS[r.category]}</span>
                <h3 class="font-display font-600">{r.title}</h3>
                <p class="text-sm" style="color: var(--sage);">{r.kcal} kcal · {r.carbs_g} g kulhydrat</p>
              </div>
            </a>
          );
        }
        if (block.type === 'articleImage') {
          const img = bodyImagesByMarker.get(block.marker);
          if (!img || !img.image_url) return null;
          const variant = articleImageCount % 3;
          articleImageCount++;
          if (variant === 0) {
            // Fuld bredde, bredt format
            return <img src={img.image_url} alt="" class="w-full aspect-[16/9] object-cover rounded-sm my-6" loading="lazy" />;
          }
          if (variant === 1) {
            // Mindre, centreret, kvadratisk med ramme
            return (
              <img src={img.image_url} alt="" class="w-2/3 mx-auto aspect-square object-cover rounded-sm my-6 border border-[var(--ink)]/15" loading="lazy" />
            );
          }
          // Mindre portræt-format, centreret ligesom kvadrat-varianten, men et andet format for variation
          return <img src={img.image_url} alt="" class="w-1/2 aspect-[3/4] object-cover rounded-sm my-6 mx-auto" loading="lazy" />;
        }
        if (block.type === 'foodlist') {
          return (
            <div class="not-prose my-8 border border-[var(--ink)]/15 rounded-2xl overflow-hidden foodlist-widget bg-[var(--card)]">
              {KETO_FOOD_LIST.map((cat, i) => (
                <input type="radio" name="foodlist-tab" id={`fl-${i}`} checked={i === 0} />
              ))}
              <div class="flex">
                {KETO_FOOD_LIST.map((cat, i) => (
                  <label for={`fl-${i}`} class="foodlist-tab-label flex-1 text-center py-3 text-sm font-medium cursor-pointer transition">
                    {cat.label}
                  </label>
                ))}
              </div>
              {KETO_FOOD_LIST.map((cat) => (
                <div class="foodlist-panel p-5">
                  <div class="space-y-4">
                    {cat.groups.map((g) => (
                      <div>
                        <h4 class="text-xs uppercase tracking-wide font-semibold mb-2" style="color: var(--rust);">{g.heading}</h4>
                        <div class="flex flex-wrap gap-2">
                          {g.items.map((item) => (
                            <span class="text-xs px-2 py-1 rounded-full border border-[var(--ink)]/20" style="color: var(--ink);">{item}</span>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          );
        }
        return <p set:html={block.html} />;
      })}
    </div>
  )}

  {relatedRecipes.length > 0 && (
    <div class="max-w-3xl mx-auto mt-14 pt-8 border-t border-[var(--ink)]/15">
      <h2 class="text-xl font-display font-600 mb-4">Alle opskrifter nævnt i denne artikel</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        {relatedRecipes.map((r) => (
          <a href={`/opskrifter/${r.slug}`} class="block bg-[var(--card)] rounded-2xl border border-[var(--ink)]/15 p-4 hover:shadow-md transition">
            <span class="text-xs uppercase tracking-wide text-[var(--rust)] font-semibold">{CATEGORY_LABELS[r.category]}</span>
            <h3 class="font-display font-600 mt-1">{r.title}</h3>
          </a>
        ))}
      </div>
    </div>
  )}
    </>
  )}
</Layout>

<style>
  .article-contents { padding: 1.5rem; border: 1px solid rgba(16,35,26,.18); border-radius: var(--radius-md); background: var(--card); }
  .foodlist-widget input { display: none; }
  .foodlist-widget .foodlist-panel { display: none; }
  .foodlist-widget .foodlist-tab-label { color: var(--ink); }
  .foodlist-widget input:nth-of-type(1):checked ~ .flex label:nth-of-type(1) { background-color: var(--rust); color: var(--paper-light) !important; }
  .foodlist-widget input:nth-of-type(2):checked ~ .flex label:nth-of-type(2) { background-color: var(--sage); color: var(--paper-light) !important; }
  .foodlist-widget input:nth-of-type(3):checked ~ .flex label:nth-of-type(3) { background-color: var(--ink); color: var(--paper-light) !important; }
  .foodlist-widget input:nth-of-type(1):checked ~ .foodlist-panel:nth-of-type(2) { display: block; }
  .foodlist-widget input:nth-of-type(2):checked ~ .foodlist-panel:nth-of-type(3) { display: block; }
  .foodlist-widget input:nth-of-type(3):checked ~ .foodlist-panel:nth-of-type(4) { display: block; }
</style>

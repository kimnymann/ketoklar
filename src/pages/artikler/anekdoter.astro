---
import Layout from '../../layouts/Layout.astro';
import type { Article } from '../../lib/db';

import { env } from "cloudflare:workers";
const db = env.DB;

const { results: anecdotes } = await db
  .prepare(`SELECT * FROM articles WHERE status = 'godkendt' AND published_at IS NOT NULL AND published_at <= datetime('now') AND category = 'anekdote' ORDER BY published_at DESC`)
  .all<Article>();

const wallColors = ['var(--ink)', 'var(--sage)', 'var(--rust)'];
---

<Layout title="Anekdoter">
  <h1 class="text-3xl font-display font-600 mb-6">Anekdoter</h1>
  <p class="text-[var(--ink)] mb-8">Historier om folk på keto, og hvorfor vi er ligeglade med, hvad andre tænker.</p>

  <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
    {anecdotes.map((a, index) => (
      <a
        href={`/artikler/${a.slug}`}
        class="block rounded-2xl p-6 hover:opacity-90 transition relative"
        style={`background-color: ${wallColors[index % wallColors.length]};`}
      >
        {a.locked === 1 && (
          <span class="absolute top-4 right-4 text-xs bg-[var(--paper-light)] text-[var(--ink)] px-2 py-1 rounded-full">Kun abonnenter</span>
        )}
        <p class="font-display text-lg italic leading-snug" style="color: var(--paper-light);">"{a.excerpt}"</p>
        <p class="text-sm font-medium mt-4 underline underline-offset-4" style="color: var(--paper);">{a.title}</p>
      </a>
    ))}
  </div>

  {anecdotes.length === 0 && <p class="text-[var(--sage)]">Ingen anekdoter endnu.</p>}
</Layout>

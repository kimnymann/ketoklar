---
import Layout from '../../layouts/Layout.astro';
import type { Article } from '../../lib/db';
import { formatPublishedDate } from '../../lib/db';

import { env } from "cloudflare:workers";
const db = env.DB;

const { results: anecdotes } = await db
  .prepare(`SELECT * FROM articles WHERE status = 'godkendt' AND published_at IS NOT NULL AND published_at <= datetime('now') AND category = 'anekdote' ORDER BY published_at DESC, id DESC`)
  .all<Article>();

const featured = anecdotes[0];
const archive = anecdotes.slice(1);
const readingTime = (body: string) => Math.max(1, Math.ceil(body.trim().split(/\s+/).length / 180));
---

<Layout title="Anekdoter" description="Korte, skæve historier fra et liv med keto.">
  <header class="anecdote-intro" data-reveal>
    <div>
      <span class="anecdote-intro__eyebrow">Keto i virkeligheden</span>
      <h1>Anekdoter</h1>
    </div>
    <p>Korte historier om madpakker, familiemiddage og alle dem, der lige har et godt råd.</p>
  </header>

  {featured && (
    <a href={`/artikler/${featured.slug}`} class="featured-anecdote" data-reveal>
      <div class="featured-anecdote__visual">
        {featured.image_url ? (
          <img src={featured.image_url} alt={featured.title} />
        ) : (
          <div class="featured-anecdote__poster" aria-hidden="true">
            <span>“</span>
            <i>Uden<br />filter</i>
          </div>
        )}
        <span class="featured-anecdote__badge">Nyeste historie</span>
      </div>
      <div class="featured-anecdote__copy">
        <span class="story-meta">01 · {readingTime(featured.body)} min. læsning</span>
        <h2>{featured.title}</h2>
        {featured.excerpt && <blockquote>“{featured.excerpt}”</blockquote>}
        <span class="story-link">Læs anekdoten <i aria-hidden="true">↗</i></span>
      </div>
    </a>
  )}

  {archive.length > 0 && (
    <section class="anecdote-archive" aria-labelledby="archive-title">
      <div class="anecdote-archive__heading" data-reveal>
        <span>Fra arkivet</span>
        <h2 id="archive-title">Flere øjeblikke<br />fra keto-livet</h2>
      </div>
      <div class="anecdote-grid">
        {archive.map((anecdote, index) => (
          <a
            href={`/artikler/${anecdote.slug}`}
            class:list={["anecdote-card", `anecdote-card--${index % 3}`]}
            data-reveal
            style={`--delay: ${index * 70}ms`}
          >
            {anecdote.image_url && (
              <div class="anecdote-card__image">
                <img src={anecdote.image_url} alt="" loading="lazy" />
              </div>
            )}
            <div class="anecdote-card__body">
              <div class="anecdote-card__meta">
                <span>{String(index + 2).padStart(2, '0')}</span>
                <span>{readingTime(anecdote.body)} min.</span>
              </div>
              <h3>{anecdote.title}</h3>
              {anecdote.excerpt && <p>“{anecdote.excerpt}”</p>}
              <div class="anecdote-card__footer">
                <time datetime={anecdote.published_at ?? undefined}>{formatPublishedDate(anecdote.published_at)}</time>
                <span aria-hidden="true">↗</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {anecdotes.length === 0 && <p class="empty-state">Ingen anekdoter endnu.</p>}
</Layout>

<style>
  .anecdote-intro { display: grid; grid-template-columns: 1fr minmax(18rem, 28rem); gap: 3rem; align-items: end; padding: 1rem 0 clamp(3rem, 7vw, 6rem); border-bottom: 1px solid rgba(16,35,26,.25); }
  .anecdote-intro__eyebrow, .anecdote-archive__heading > span { display: block; margin-bottom: .7rem; color: var(--tomato-dark); font-size: .68rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  .anecdote-intro h1 { font-family: var(--font-display); font-size: clamp(4.5rem, 12vw, 9rem); font-weight: 500; letter-spacing: -.075em; line-height: .78; }
  .anecdote-intro p { color: var(--muted); font-family: var(--font-display); font-size: clamp(1.25rem, 2.4vw, 1.75rem); line-height: 1.18; }
  .featured-anecdote { display: grid; grid-template-columns: 1.15fr .85fr; min-height: 36rem; margin-top: clamp(2rem, 5vw, 4rem); overflow: hidden; border-radius: var(--radius-lg); color: var(--cream); background: var(--forest); }
  .featured-anecdote__visual { position: relative; min-height: 30rem; overflow: hidden; }
  .featured-anecdote__visual img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .featured-anecdote:hover .featured-anecdote__visual img { transform: scale(1.035); }
  .featured-anecdote__poster { display: grid; place-items: center; width: 100%; height: 100%; min-height: 30rem; color: var(--ink); background: var(--sky); }
  .featured-anecdote__poster span { position: absolute; top: -.8rem; left: 1.5rem; color: var(--tomato); font-family: var(--font-display); font-size: 14rem; line-height: 1; }
  .featured-anecdote__poster i { position: relative; font-family: var(--font-display); font-size: clamp(4rem, 8vw, 7rem); font-weight: 600; letter-spacing: -.07em; line-height: .78; transform: rotate(-7deg); }
  .featured-anecdote__badge { position: absolute; left: 1rem; bottom: 1rem; padding: .65rem .85rem; border-radius: 999px; color: var(--ink); background: var(--lime); font-size: .63rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .featured-anecdote__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 5vw, 4.5rem); }
  .story-meta { color: var(--lime); font-size: .66rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  .featured-anecdote h2 { max-width: 11ch; margin-top: 1rem; font-family: var(--font-display); font-size: clamp(2.7rem, 5vw, 4.8rem); font-weight: 500; letter-spacing: -.06em; line-height: .88; }
  .featured-anecdote blockquote { margin: 2rem 0 0; color: rgba(255,250,240,.78); font-family: var(--font-display); font-size: 1.15rem; font-style: italic; line-height: 1.45; }
  .story-link { display: flex; justify-content: space-between; align-items: center; margin-top: 2.25rem; padding-top: 1rem; border-top: 1px solid rgba(255,250,240,.28); color: var(--lime); font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .story-link i { font-size: 1.25rem; font-style: normal; transition: transform .2s ease; }
  .featured-anecdote:hover .story-link i { transform: translate(3px,-3px); }
  .anecdote-archive { padding-top: clamp(5rem, 9vw, 8rem); }
  .anecdote-archive__heading { display: flex; justify-content: space-between; gap: 2rem; align-items: start; margin-bottom: 2.5rem; }
  .anecdote-archive__heading h2 { font-family: var(--font-display); font-size: clamp(2.8rem, 6vw, 5rem); font-weight: 500; letter-spacing: -.06em; line-height: .88; text-align: right; }
  .anecdote-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1.25rem; }
  .anecdote-card { min-height: 28rem; overflow: hidden; border-radius: var(--radius-md); background: var(--card); }
  .anecdote-card:nth-child(3n) { grid-column: 1 / -1; display: grid; grid-template-columns: .8fr 1.2fr; min-height: 23rem; }
  .anecdote-card__image { min-height: 15rem; overflow: hidden; }
  .anecdote-card__image img { width: 100%; height: 100%; object-fit: cover; transition: transform .65s ease; }
  .anecdote-card:hover img { transform: scale(1.04); }
  .anecdote-card__body { display: flex; flex-direction: column; height: 100%; padding: clamp(1.5rem, 4vw, 2.6rem); }
  .anecdote-card--0 { color: var(--cream); background: var(--tomato); }
  .anecdote-card--1 { color: var(--ink); background: var(--sky); }
  .anecdote-card--2 { color: var(--cream); background: var(--forest); }
  .anecdote-card__meta { display: flex; justify-content: space-between; font-size: .63rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; opacity: .72; }
  .anecdote-card h3 { max-width: 13ch; margin-top: auto; padding-top: 3rem; font-family: var(--font-display); font-size: clamp(2.1rem, 4vw, 3.5rem); font-weight: 550; letter-spacing: -.055em; line-height: .92; }
  .anecdote-card p { max-width: 34rem; margin-top: 1rem; font-family: var(--font-display); font-size: 1rem; font-style: italic; line-height: 1.45; opacity: .82; }
  .anecdote-card__footer { display: flex; justify-content: space-between; align-items: end; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid currentColor; font-size: .65rem; letter-spacing: .08em; text-transform: uppercase; opacity: .75; }
  .anecdote-card__footer span { font-size: 1.25rem; transition: transform .2s ease; }
  .anecdote-card:hover .anecdote-card__footer span { transform: translate(3px,-3px); }
  .empty-state { padding: 5rem 0; color: var(--muted); }
  @media (max-width: 720px) {
    .anecdote-intro { grid-template-columns: 1fr; gap: 1.5rem; padding-top: 0; }
    .anecdote-intro h1 { font-size: clamp(4.2rem, 24vw, 7rem); }
    .anecdote-intro p { max-width: 22rem; }
    .featured-anecdote { grid-template-columns: 1fr; }
    .featured-anecdote__visual { min-height: 75vw; }
    .featured-anecdote__copy { min-height: 28rem; }
    .anecdote-archive__heading { display: block; }
    .anecdote-archive__heading h2 { text-align: left; }
    .anecdote-grid { grid-template-columns: 1fr; }
    .anecdote-card, .anecdote-card:nth-child(3n) { display: block; grid-column: auto; min-height: 27rem; }
    .anecdote-card h3 { font-size: 2.65rem; }
  }
</style>

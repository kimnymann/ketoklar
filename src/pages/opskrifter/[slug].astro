---
import Layout from '../../layouts/Layout.astro';
import type { Recipe, Article } from '../../lib/db';
import { CATEGORY_LABELS } from '../../lib/db';
import { groupIngredientsByCategory, splitInstructionsIntoSteps } from '../../lib/ingredientCategory';

const { slug } = Astro.params;
import { env } from "cloudflare:workers";
const db = env.DB;

const recipe = await db
  .prepare(`SELECT * FROM recipes WHERE slug = ? AND status = 'godkendt' AND published_at IS NOT NULL AND published_at <= datetime('now')`)
  .bind(slug)
  .first<Recipe>();

if (!recipe) {
  return Astro.redirect('/opskrifter');
}

const ingredients = JSON.parse(recipe.ingredients_json) as Array<{ name: string; amount: number; unit: string }>;
const ingredientGroups = groupIngredientsByCategory(ingredients);
const steps = splitInstructionsIntoSteps(recipe.instructions);

const { results: relatedArticles } = await db
  .prepare(`
    SELECT a.* FROM articles a
    JOIN article_recipes ar ON ar.article_id = a.id
    WHERE ar.recipe_id = ? AND a.status = 'godkendt' AND a.published_at IS NOT NULL AND a.published_at <= datetime('now')
  `)
  .bind(recipe.id)
  .all<Article>();

// TODO fase 2: erstat med rigtigt abonnements-tjek (session/cookie)
const isSubscriber = false;
const isLocked = recipe.locked === 1 && !isSubscriber;
---

<Layout title={recipe.title}>
  {recipe.image_url ? (
    <img src={recipe.image_url} alt={recipe.title} class="w-full aspect-[21/9] object-cover rounded-sm mb-6" />
  ) : (
    <div class="w-full aspect-[21/9] rounded-sm mb-6" style="background-color: var(--sage);"></div>
  )}

  <span class="text-xs uppercase tracking-wide text-[var(--rust)] font-semibold">{CATEGORY_LABELS[recipe.category]}</span>
  <h1 class="text-3xl font-display font-600 mt-1 mb-4">{recipe.title}</h1>
  <p class="text-sm text-[var(--sage)] mb-8">
    {recipe.servings} portioner · {recipe.prep_minutes} min · {recipe.kcal} kcal pr. portion · {recipe.carbs_g} g kulhydrat · {recipe.fat_g} g fedt · {recipe.protein_g} g protein
  </p>

  {isLocked ? (
    <div class="bg-[var(--paper-light)] border border-[var(--ink)]/15 rounded-2xl p-10 text-center">
      <p class="text-lg font-semibold mb-2">Denne opskrift er kun for abonnenter.</p>
      <p class="text-[var(--sage)] mb-6">Bliv abonnent og få adgang til alle låste opskrifter, artikler og madplaner.</p>
      <a href="/abonnement" class="inline-block bg-[var(--rust)] text-white px-6 py-3 rounded-full font-medium hover:bg-[var(--rust-dark)] transition">
        Se abonnement
      </a>
    </div>
  ) : (
    <div class="grid md:grid-cols-3 gap-10">
      <div>
        <h2 class="text-xl font-display font-600 mb-4">Ingredienser</h2>
        <div class="space-y-5">
          {ingredientGroups.map((group) => (
            <div>
              <h3 class="text-xs uppercase tracking-wide font-semibold mb-2" style="color: var(--rust);">{group.category}</h3>
              <ul class="space-y-1.5 text-[var(--ink)]">
                {group.items.map((i) => (
                  <li class="flex items-baseline gap-2">
                    <span class="w-1.5 h-1.5 rounded-full flex-shrink-0 mb-0.5" style="background-color: var(--sage);"></span>
                    <span>{i.amount > 0 ? `${i.amount}${i.unit ? ' ' + i.unit : ''} ` : ''}{i.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
      <div class="md:col-span-2">
        <h2 class="text-xl font-display font-600 mb-4">Fremgangsmåde</h2>
        <ol class="space-y-4">
          {steps.map((step, index) => (
            <li class="flex gap-4">
              <span
                class="flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-sm font-display font-600"
                style="background-color: var(--rust); color: var(--paper-light);"
              >
                {index + 1}
              </span>
              <p class="text-[var(--ink)] leading-relaxed pt-0.5">{step}</p>
            </li>
          ))}
        </ol>

        {recipe.tips && (
          <div class="mt-6 flex gap-3 p-4 rounded-2xl border" style="background-color: var(--paper-light); border-color: var(--ink)/15;">
            <span class="text-xl leading-none">💡</span>
            <div>
              <span class="text-xs uppercase tracking-wide font-semibold" style="color: var(--rust);">Tip</span>
              <p class="text-[var(--ink)] mt-1">{recipe.tips}</p>
            </div>
          </div>
        )}
      </div>
    </div>
  )}

  {relatedArticles.length > 0 && (
    <div class="mt-14 pt-8 border-t border-[var(--ink)]/15">
      <h2 class="text-xl font-display font-600 mb-4">Læs mere</h2>
      <div class="flex flex-wrap gap-4">
        {relatedArticles.map((a) => (
          <a href={`/artikler/${a.slug}`} class="text-[var(--rust)] font-medium hover:underline">{a.title} →</a>
        ))}
      </div>
    </div>
  )}
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import type { Recipe } from '../../lib/db';
import { CATEGORY_LABELS } from '../../lib/db';

import { env } from "cloudflare:workers";
const db = env.DB;
const category = Astro.url.searchParams.get('kategori');

const query = category
  ? db.prepare(`SELECT * FROM recipes WHERE status = 'godkendt' AND published_at IS NOT NULL AND published_at <= datetime('now') AND category = ? ORDER BY published_at DESC`).bind(category)
  : db.prepare(`SELECT * FROM recipes WHERE status = 'godkendt' AND published_at IS NOT NULL AND published_at <= datetime('now') ORDER BY published_at DESC`);

const { results: recipes } = await query.all<Recipe>();

const categories: Array<Recipe['category']> = ['morgen', 'frokost', 'aften', 'laekkerier'];
---

<Layout title="Opskrifter">
  <h1 class="text-3xl font-display font-600 mb-6">Opskrifter</h1>

  <div class="flex gap-2 mb-8 flex-wrap">
    <a href="/opskrifter" class={`px-4 py-2 rounded-full text-sm font-medium border ${!category ? 'bg-[var(--rust)] text-white border-[var(--rust)]' : 'border-[var(--sage)]/40 text-[var(--ink)]'}`}>
      Alle
    </a>
    {categories.map((c) => (
      <a href={`/opskrifter?kategori=${c}`} class={`px-4 py-2 rounded-full text-sm font-medium border ${category === c ? 'bg-[var(--rust)] text-white border-[var(--rust)]' : 'border-[var(--sage)]/40 text-[var(--ink)]'}`}>
        {CATEGORY_LABELS[c]}
      </a>
    ))}
  </div>

  <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
    {recipes.map((r) => (
      <a href={`/opskrifter/${r.slug}`} class="block bg-[var(--card)] rounded-2xl border border-[var(--ink)]/15 overflow-hidden hover:shadow-md transition relative">
        {r.locked === 1 && (
          <span class="absolute top-4 right-4 z-10 text-xs bg-[var(--ink)] text-white px-2 py-1 rounded-full">Kun abonnenter</span>
        )}
        {r.image_url ? (
          <img src={r.image_url} alt={r.title} class="aspect-[4/3] w-full object-cover" loading="lazy" />
        ) : (
          <div class="aspect-[4/3] flex items-end p-4" style="background-color: var(--sage);">
            <span class="font-display text-white leading-tight">{r.title}</span>
          </div>
        )}
        <div class="p-5">
          <span class="text-xs uppercase tracking-wide text-[var(--rust)] font-semibold">{CATEGORY_LABELS[r.category]}</span>
          <h3 class="text-lg font-display font-600 mt-1">{r.title}</h3>
          <p class="text-sm text-[var(--sage)] mt-2">{r.kcal} kcal · {r.carbs_g} g kulhydrat · {r.prep_minutes} min</p>
        </div>
      </a>
    ))}
  </div>

  {recipes.length === 0 && <p class="text-[var(--sage)]">Ingen opskrifter i denne kategori endnu.</p>}
</Layout>

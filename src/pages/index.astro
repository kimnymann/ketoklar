---
import Layout from '../layouts/Layout.astro';
import { env } from "cloudflare:workers";
import type { Recipe, Article } from '../lib/db';
import { CATEGORY_LABELS } from '../lib/db';

const db = env.DB;

const lead = await db
  .prepare(`SELECT * FROM articles WHERE status = 'godkendt' AND category IN ('videnskab','livsstil') AND published_at IS NOT NULL AND published_at <= datetime('now') ORDER BY published_at DESC LIMIT 1`)
  .first<Article>();

const anecdote = await db
  .prepare(`SELECT * FROM articles WHERE status = 'godkendt' AND category = 'anekdote' AND published_at IS NOT NULL AND published_at <= datetime('now') ORDER BY published_at DESC LIMIT 1`)
  .first<Article>();

const categories: Array<Recipe['category']> = ['morgen', 'frokost', 'aften', 'laekkerier'];
const departmentEntries = await Promise.all(
  categories.map(async (cat) => {
    const { results } = await db
      .prepare(`SELECT * FROM recipes WHERE status = 'godkendt' AND category = ? AND published_at IS NOT NULL AND published_at <= datetime('now') ORDER BY published_at DESC LIMIT 3`)
      .bind(cat)
      .all<Recipe>();
    return { category: cat, recipes: results };
  })
);
---

<Layout title="Forside">
  {lead && (
    <section class="mb-16">
      <span class="text-xs font-medium uppercase" style="color: var(--rust);">Ugens historie</span>
      <a href={`/artikler/${lead.slug}`} class="block group mt-2">
        {lead.image_url && (
          <img src={lead.image_url} alt={lead.title} class="w-full aspect-[21/9] object-cover rounded-sm mb-5" />
        )}
        <h1 class="font-display text-4xl md:text-5xl leading-tight font-700 group-hover:opacity-80" style="color: var(--ink);">
          {lead.title}
        </h1>
        <p class="mt-4 text-lg max-w-2xl" style="color: var(--ink);">{lead.excerpt}</p>
        <span class="inline-block mt-4 text-sm font-medium" style="color: var(--rust);">Læs historien</span>
      </a>
    </section>
  )}

  {anecdote && (
    <section
      class="mb-16 rounded-sm p-8 md:p-10 relative overflow-hidden"
      style={anecdote.image_url
        ? `background-image: linear-gradient(rgba(43,32,22,0.75), rgba(43,32,22,0.75)), url(${anecdote.image_url}); background-size: cover; background-position: center; color: var(--paper-light);`
        : 'background-color: var(--ink); color: var(--paper-light);'}
    >
      <span class="text-xs font-medium uppercase" style="color: var(--paper);">Fra anekdote-serien</span>
      <p class="font-display text-2xl md:text-3xl italic leading-snug mt-3 max-w-3xl">
        "{anecdote.excerpt}"
      </p>
      <a href={`/artikler/${anecdote.slug}`} class="inline-block mt-5 text-sm font-medium underline underline-offset-4">
        {anecdote.title}
      </a>
    </section>
  )}

  <div class="space-y-14">
    {departmentEntries.map(({ category, recipes }) => recipes.length > 0 && (
      <section>
        <div class="flex items-baseline justify-between mb-5 border-b pb-2" style="border-color: var(--ink);">
          <h2 class="font-display text-2xl font-600" style="color: var(--ink);">{CATEGORY_LABELS[category]}</h2>
          <a href={`/opskrifter?kategori=${category}`} class="text-sm font-medium" style="color: var(--rust);">Se alle →</a>
        </div>
        <div class="grid sm:grid-cols-3 gap-6">
          {recipes.map((r) => (
            <a href={`/opskrifter/${r.slug}`} class="block group">
              {r.image_url ? (
                <img src={r.image_url} alt={r.title} class="aspect-[4/3] w-full object-cover mb-3 rounded-sm" loading="lazy" />
              ) : (
                <div class="aspect-[4/3] mb-3 rounded-sm" style="background-color: var(--sage);"></div>
              )}
              <h3 class="font-display font-600" style="color: var(--ink);">{r.title}</h3>
              <p class="text-sm" style="color: var(--sage);">{r.kcal} kcal · {r.carbs_g} g kulhydrat · {r.prep_minutes} min</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

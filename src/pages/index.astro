---
import Layout from '../layouts/Layout.astro';
import type { Recipe, Article } from '../lib/db';
import { CATEGORY_LABELS } from '../lib/db';

import { env } from "cloudflare:workers";
const db = env.DB;

const { results: recipes } = await db
  .prepare(`SELECT * FROM recipes WHERE status = 'godkendt' AND published_at IS NOT NULL AND published_at <= datetime('now') ORDER BY published_at DESC LIMIT 6`)
  .all<Recipe>();

const { results: articles } = await db
  .prepare(`SELECT * FROM articles WHERE status = 'godkendt' AND published_at IS NOT NULL AND published_at <= datetime('now') ORDER BY published_at DESC LIMIT 3`)
  .all<Article>();
---

<Layout title="Forside">
  <section class="text-center py-16">
    <h1 class="text-4xl md:text-5xl font-bold text-stone-900 mb-4">Velkommen til dit keto univers</h1>
    <p class="text-lg text-stone-600 max-w-xl mx-auto">
      Opskrifter til morgen, frokost, aften og lækkerier. Artikler om videnskaben bag keto.
      Og anekdoter, der minder dig om, hvorfor du gør det her.
    </p>
    <a href="/opskrifter" class="inline-block mt-8 bg-amber-800 text-white px-6 py-3 rounded-full font-medium hover:bg-amber-900 transition">
      Find en opskrift
    </a>
  </section>

  <section class="py-10">
    <h2 class="text-2xl font-bold mb-6">Seneste opskrifter</h2>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
      {recipes.map((r) => (
        <a href={`/opskrifter/${r.slug}`} class="block bg-white rounded-2xl border border-stone-200 p-5 hover:shadow-md transition">
          <span class="text-xs uppercase tracking-wide text-amber-800 font-semibold">{CATEGORY_LABELS[r.category]}</span>
          <h3 class="text-lg font-bold mt-1">{r.title}</h3>
          <p class="text-sm text-stone-500 mt-2">{r.kcal} kcal · {r.carbs_g} g kulhydrat</p>
        </a>
      ))}
    </div>
  </section>

  <section class="py-10">
    <h2 class="text-2xl font-bold mb-6">Fra bloggen</h2>
    <div class="grid sm:grid-cols-3 gap-6">
      {articles.map((a) => (
        <a href={`/artikler/${a.slug}`} class="block bg-white rounded-2xl border border-stone-200 p-5 hover:shadow-md transition">
          <span class="text-xs uppercase tracking-wide text-amber-800 font-semibold">{a.category}</span>
          <h3 class="text-lg font-bold mt-1">{a.title}</h3>
          <p class="text-sm text-stone-500 mt-2">{a.excerpt}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>

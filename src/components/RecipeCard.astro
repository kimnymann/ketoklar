---
import type { Recipe } from '../lib/db';
import { CATEGORY_LABELS } from '../lib/db';

interface Props {
  recipe: Recipe;
  index?: number;
}

const { recipe, index = 0 } = Astro.props;
---

<a href={`/opskrifter/${recipe.slug}`} class="recipe-card group" data-reveal style={`--delay: ${index * 70}ms`}>
  <div class="recipe-card__image-wrap">
    {recipe.image_url ? (
      <img src={recipe.image_url} alt={recipe.title} class="recipe-card__image" loading="lazy" />
    ) : (
      <div class="recipe-card__placeholder"></div>
    )}
    <span class="recipe-card__number">0{index + 1}</span>
    <span class="recipe-card__arrow" aria-hidden="true">↗</span>
  </div>
  <div class="recipe-card__meta">
    <span>{CATEGORY_LABELS[recipe.category]}</span>
    <span>{recipe.prep_minutes} min</span>
  </div>
  <h3>{recipe.title}</h3>
  <p>{recipe.kcal} kcal <i></i> {recipe.carbs_g} g kulhydrat</p>
</a>

<style>
  .recipe-card { display: block; color: inherit; }
  .recipe-card__image-wrap { position: relative; overflow: hidden; aspect-ratio: 4 / 3; border-radius: var(--radius-md); background: var(--sage); }
  .recipe-card__image, .recipe-card__placeholder { width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2,.75,.25,1), filter .4s ease; }
  .recipe-card:hover .recipe-card__image { transform: scale(1.045); filter: saturate(1.08); }
  .recipe-card__number, .recipe-card__arrow { position: absolute; top: .75rem; display: grid; place-items: center; min-width: 2.1rem; height: 2.1rem; border-radius: 999px; font-size: .72rem; font-weight: 700; }
  .recipe-card__number { left: .75rem; color: var(--ink); background: var(--lime); }
  .recipe-card__arrow { right: .75rem; color: var(--cream); background: var(--ink); font-size: 1rem; transition: transform .25s ease, background .25s ease; }
  .recipe-card:hover .recipe-card__arrow { transform: rotate(45deg); background: var(--tomato); }
  .recipe-card__meta { display: flex; justify-content: space-between; margin-top: .85rem; color: var(--tomato-dark); font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  h3 { margin-top: .35rem; font-family: var(--font-display); font-size: clamp(1.35rem, 2vw, 1.75rem); font-weight: 600; letter-spacing: -.035em; line-height: 1.05; }
  p { display: flex; align-items: center; gap: .45rem; margin-top: .5rem; color: var(--muted); font-size: .8rem; }
  p i { width: 3px; height: 3px; border-radius: 50%; background: currentColor; }
</style>

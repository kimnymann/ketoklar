---
interface Props { items: { title: string; html: string }[]; kind: 'lunch' | 'dinner' }
const { items, kind } = Astro.props;
---
<div class="meal-cards" aria-label={kind === 'lunch' ? 'Tre madpakkeidéer' : 'Tre idéer til aftensmad'}>
  {items.map((item, i) => (
    <details class="meal-card">
      <summary>
        <span class="meal-number" aria-hidden="true">0{i + 1}</span>
        <span class="meal-label">{kind === 'lunch' ? 'Med på farten' : 'Til aftensbordet'}</span>
        <span class="meal-title">{item.title}</span>
        <span class="meal-toggle"><span class="closed-label">Se indhold og tip</span><span class="open-label">Skjul indhold</span><span aria-hidden="true">＋</span></span>
      </summary>
      <div class="meal-content"><p set:html={item.html} /></div>
    </details>
  ))}
</div>
<style>
  .meal-cards { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; align-items:start; }
  .meal-card { border:1px solid #cbd5c6; border-radius:16px; background:#f4f6ed; overflow:hidden; min-width:0; }
  .meal-card:nth-child(2) { background:#fbf0e7; border-color:#e6c9b8; }
  .meal-card:nth-child(3) { background:#f1f3ed; }
  summary { padding:1.25rem; cursor:pointer; list-style:none; }
  summary::-webkit-details-marker { display:none; }
  summary:focus-visible { outline:3px solid var(--rust); outline-offset:-4px; border-radius:16px; }
  .meal-number { display:block; font-family:var(--font-display); font-size:2rem; color:#43634b; line-height:1; margin-bottom:1.25rem; }
  .meal-label { display:block; text-transform:uppercase; font-size:.65rem; letter-spacing:.08em; margin-bottom:.5rem; }
  .meal-title { display:block; font-family:var(--font-display); font-weight:600; font-size:1.2rem; line-height:1.3; min-height:3.2em; }
  .meal-toggle { display:flex; justify-content:space-between; gap:.5rem; font-size:.78rem; margin-top:1rem; align-items:center; }
  .meal-toggle > span:last-child { font-size:1.2rem; }
  .open-label { display:none; }
  details[open] .closed-label { display:none; }
  details[open] .open-label { display:inline; }
  details[open] .meal-toggle > span:last-child { transform:rotate(45deg); }
  .meal-content { padding:0 1.25rem 1.25rem; font-size:.9rem; line-height:1.65; overflow-wrap:anywhere; }
  @media(max-width:640px) { .meal-cards { grid-template-columns:1fr; } .meal-title { min-height:0; } .meal-number { float:right; margin:0 0 .5rem 1rem; } }
  @media print { .meal-cards { display:block; } .meal-card { break-inside:avoid; margin-bottom:1rem; } .meal-content { display:block !important; } details::details-content { content-visibility:visible; } .meal-toggle { display:none; } }
</style>

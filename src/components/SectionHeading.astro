---
interface Props {
  eyebrow: string;
  title: string;
  href?: string;
  linkLabel?: string;
}

const { eyebrow, title, href, linkLabel = 'Se alt' } = Astro.props;
---

<header class="section-heading" data-reveal>
  <div>
    <span class="eyebrow">{eyebrow}</span>
    <h2>{title}</h2>
  </div>
  {href && <a href={href}>{linkLabel}<span aria-hidden="true">↗</span></a>}
</header>

<style>
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.75rem; padding-bottom: 1rem; border-bottom: 1px solid color-mix(in srgb, var(--ink) 24%, transparent); }
  .eyebrow { display: block; margin-bottom: .4rem; color: var(--tomato-dark); font-size: .68rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  h2 { font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 4.75rem); font-weight: 600; letter-spacing: -.055em; line-height: .88; }
  a { display: inline-flex; align-items: center; gap: .55rem; padding: .65rem .9rem; border: 1px solid currentColor; border-radius: 999px; font-size: .72rem; font-weight: 700; white-space: nowrap; text-transform: uppercase; transition: color .2s ease, background .2s ease; }
  a:hover { color: var(--cream); background: var(--ink); }
  a span { font-size: .95rem; }
</style>

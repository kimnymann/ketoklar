<aside id="cookie-notice" class="cookie-notice" aria-labelledby="cookie-title" hidden>
  <div>
    <h2 id="cookie-title">Må vi måle besøget?</h2>
    <p>Med dit ja bruger vi Cloudflare Web Analytics til besøgsstatistik og måling af sidens hastighed. Statistikken bruger ikke cookies. Cloudflare kan behandle oplysninger uden for EU/EØS. Vi bruger ingen annoncesporing. Bedømmelser bruger en nødvendig cookie og et sikkerhedstjek.</p>
    <p><a href="/cookies">Læs om cookies</a> · <a href="/privatliv">Læs om dit privatliv</a></p>
  </div>
  <div class="cookie-actions">
    <button type="button" id="cookie-reject">Nej til statistik</button>
    <button type="button" id="cookie-accept">Ja til statistik</button>
  </div>
</aside>

<script>
  const notice = document.getElementById('cookie-notice');
  const reject = document.getElementById('cookie-reject');
  const accept = document.getElementById('cookie-accept');
  const key = 'kk_analytics_consent';
  const lifetime = 180 * 24 * 60 * 60 * 1000;
  let opener: HTMLElement | null = null;
  let analyticsLoaded = false;
  function loadAnalytics() {
    if (analyticsLoaded || location.hostname !== 'ketoklar.dk') return;
    analyticsLoaded = true;
    const script = document.createElement('script');
    script.type = 'module';
    script.src = 'https://static.cloudflareinsights.com/beacon.min.js';
    script.dataset.cfBeacon = JSON.stringify({ token: 'd388f3d9d2b1464faf9cfded6f2fd726' });
    document.head.appendChild(script);
  }
  try {
    const saved = JSON.parse(localStorage.getItem(key) || 'null');
    const valid = saved?.version === 1 && typeof saved?.allowed === 'boolean' && Number.isFinite(saved?.expires) && saved.expires > Date.now() && saved.expires <= Date.now() + lifetime;
    if (notice) notice.hidden = valid;
    if (valid && saved.allowed) loadAnalytics();
  } catch {
    if (notice) notice.hidden = false;
  }
  function choose(allowed: boolean) {
    try { localStorage.setItem(key, JSON.stringify({ version: 1, allowed, expires: Date.now() + lifetime })); } catch { /* Choice applies to this page even without storage. */ }
    if (notice) notice.hidden = true;
    if (!allowed && analyticsLoaded) { location.reload(); return; }
    if (allowed) loadAnalytics();
    if (opener) opener.focus();
    else document.querySelector<HTMLAnchorElement>('.site-logo')?.focus();
  }
  reject?.addEventListener('click', () => choose(false));
  accept?.addEventListener('click', () => choose(true));
  window.addEventListener('storage', (event) => {
    if (event.key === key || event.key === null) location.reload();
  });
  document.querySelectorAll<HTMLElement>('[data-cookie-notice]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      opener = trigger;
      if (notice) notice.hidden = false;
      reject?.focus();
    });
  });
</script>

<style>
  .cookie-notice[hidden] { display: none; }
  .cookie-notice { position: fixed; z-index: 100; inset: auto 1rem 1rem; margin-inline: auto; max-width: 58rem; display: flex; align-items: center; gap: 1.5rem; padding: 1.5rem; max-height: 65dvh; overflow-y: auto; color: var(--ink); background: var(--paper-light); border: 1px solid var(--sage); border-radius: 1.25rem; box-shadow: 0 8px 40px #10231a30; }
  h2 { margin: 0 0 .5rem; font-family: var(--font-display); font-size: 1.5rem; }
  p { margin: .4rem 0 0; font-size: .9rem; line-height: 1.55; }
  a { text-decoration: underline; text-underline-offset: .2em; }
  button { flex-shrink: 0; padding: .85rem 1.5rem; border: 0; border-radius: 999px; background: var(--forest); color: var(--cream); font: inherit; font-weight: 700; cursor: pointer; }
  .cookie-actions { display: flex; flex-direction: column; gap: .6rem; flex-shrink: 0; }
  :is(a, button):focus-visible { outline: 3px solid var(--tomato-dark); outline-offset: 4px; }
  @media (max-width: 600px) { .cookie-notice { flex-direction: column; align-items: stretch; gap: 1rem; padding: 1.2rem; } }
</style>

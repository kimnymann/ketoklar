---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
import { SITE_URL, absoluteUrl } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  image?: string | null;
  canonicalPath?: string;
  pageType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = 'Keto-opskrifter, viden og historier for mennesker, der godt kan lide rigtig mad.',
  wide = false,
  image,
  canonicalPath,
  pageType = 'website',
  structuredData,
} = Astro.props;

const pageTitle = `${title} · Ketoklar`;
const canonicalUrl = absoluteUrl(canonicalPath ?? Astro.url.pathname);
const imageUrl = image ? absoluteUrl(image) : undefined;
const additionalStructuredData = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData])
  : [];
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: 'Ketoklar',
      url: `${SITE_URL}/`,
      logo: absoluteUrl('/favicon.svg'),
      email: 'hej@ketoklar.dk',
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: 'Ketoklar',
      alternateName: 'KetoKlar',
      url: `${SITE_URL}/`,
      inLanguage: 'da-DK',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
    ...additionalStructuredData,
  ],
}).replace(/</g, '\\u003c');

const today = new Intl.DateTimeFormat('da-DK', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  timeZone: 'Europe/Copenhagen',
}).format(new Date());
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#143f2d" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta property="og:site_name" content="Ketoklar" />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <script type="application/ld+json" is:inline set:html={jsonLd}></script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="edition-bar">
      <div class="site-frame edition-bar__inner">
        <span>Danmarks sultneste ketomagasin</span>
        <span class="edition-bar__dot" aria-hidden="true"></span>
        <span class="edition-bar__date">{today}</span>
      </div>
    </div>
    <header class="site-header">
      <div class="site-frame site-header__inner">
        <a href="/" class="site-logo"><BrandMark /></a>
        <nav class="site-nav" aria-label="Primær navigation">
          <a href="/opskrifter">Opskrifter</a>
          <a href="/artikler">Artikler</a>
          <a href="/artikler/anekdoter">Anekdoter</a>
        </nav>
        <a href="/artikler/keto-for-begyndere-guide" class="start-link">Ny på keto? <span aria-hidden="true">→</span></a>
      </div>
    </header>
    <main class:list={["page-main", { "page-main--wide": wide }] }>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-frame site-footer__top">
        <BrandMark light />
        <p>Et magasin for dem, der lever på fedt, nysgerrighed og virkelig gode historier.</p>
        <div class="site-footer__links">
          <a href="/om-kim-sax">Om Kim Sax <span aria-hidden="true">↗</span></a>
          <a href="/artikler/keto-for-begyndere-guide">Ny på keto? <span aria-hidden="true">↗</span></a>
          <a href="/opskrifter">Find aftensmaden <span aria-hidden="true">↗</span></a>
          <a href="mailto:hej@ketoklar.dk">hej@ketoklar.dk <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="site-frame site-footer__bottom">
        <div class="company-signature">
          <strong>Ketoklar</strong>
          <span class="company-signature__stripe" aria-hidden="true"></span>
          <span>en del af</span>
          <strong class="company-signature__group">SAX GRUPPEN</strong>
          <i aria-hidden="true"></i>
          <span>CVR 38239031</span>
        </div>
        <span>Ny opskrift næsten hver dag</span>
      </div>
    </footer>

    <script>
      const revealItems = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
